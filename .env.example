# Copy to .env.local (Next.js) and .env (drizzle-kit, scripts). Never commit real values.

# Postgres. Neon in production (use the *pooled* connection string).
DATABASE_URL=postgres://localhost:5432/slotwise

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Public origin of the app, used in magic links and emails.
AUTH_URL=http://localhost:3000

# Resend — magic-link and booking emails. Leave empty locally to print links to the console.
RESEND_API_KEY=
EMAIL_FROM="Slotwise <hello@bhupathi.dev>"

# Demo account behind the "Try the demo" button (created by `npm run db:seed`).
DEMO_EMAIL=demo@slotwise.dev

# Stripe test mode (Day 2)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Protects /api/cron/* (Day 3)
CRON_SECRET=
